# ============================================================
# ShadowScopeAI - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# The backend reads these via Pydantic Settings.
# ============================================================

# ----- Strix CLI -----
# Path to the strix executable (auto-detected if on PATH)
# STRIX_PATH=C:\Users\<you>\AppData\Local\Programs\Python\Python313\Scripts\strix.exe

# ----- LLM Provider -----
# Mode: AUTO | GEMINI | OLLAMA
# LLM_PROVIDER_MODE=AUTO

# Gemini (reads from ~/.strix/cli-config.json if not set here)
# GEMINI_API_KEY=your-api-key-here

# Ollama (local fallback)
# OLLAMA_BASE_URL=http://localhost:11434

# ----- Server -----
# HOST=127.0.0.1
# PORT=8000

# ----- Database -----
# DATABASE_URL=sqlite+aiosqlite:///./security_platform.db

# ----- Scan Directories -----
# Comma-separated paths for auto-discovery of existing Strix runs
# STRIX_DISCOVERY_DIRS=C:\Users\<you>\OneDrive\Desktop\SignBridgeAI\strix_runs
