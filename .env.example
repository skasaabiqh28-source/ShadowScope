# ============================================================
# ShadowScopeAI - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# The backend reads these via Pydantic Settings.
# ============================================================

# ----- Strix CLI -----
# Path to the strix executable (auto-detected if on PATH)
# STRIX_EXECUTABLE=strix

# ----- LLM Provider -----
# Mode: AUTO | GEMINI | OLLAMA
# LLM_PROVIDER_MODE=AUTO

# Gemini (reads from ~/.strix/cli-config.json if not set here)
# GEMINI_API_KEY=your-api-key-here

# Ollama (local fallback — not available on Render)
# OLLAMA_BASE_URL=http://localhost:11434

# ----- Server -----
# PORT=8000

# ----- Database -----
# DATABASE_URL=sqlite+aiosqlite:///./security_platform.db

# ----- Scan Directories -----
# Comma-separated paths for auto-discovery of existing Strix runs
# DISCOVERY_RUNS_DIRS=["./strix_runs"]

# ----- Render Deployment -----
# Set these when deploying to Render (render.yaml sets them automatically)
# RENDER=true
# FRONTEND_ORIGIN=https://your-app.onrender.com
